{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/rapidsai/dependency-file-generator/v1.22.0/src/rapids_dependency_file_generator/schema.json",
    "type": "object",
    "title": "RAPIDS Package Dependency Specification Format",
    "description": "Consolidated specification of RAPIDS project dependencies",
    "properties": {
        "files": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties": {
                        "output": {"$ref": "#/$defs/outputs"},
                        "extras": {"$ref": "#/$defs/extras"},
                        "includes": {"type": "array", "items": {"type": "string"}},
                        "matrix": {"$ref": "#/$defs/matrix"},
                        "requirements_dir": {"type": "string"},
                        "constraints_dir": {"type": "string"},
                        "conda_dir": {"type": "string"},
                        "pyproject_dir": {"type": "string"},
                        "recipe_dir": {"type": "string"}
                    },
                    "additionalProperties": false,
                    "required": ["output", "includes"],
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "output": {
                                        "anyOf": [
                                            {
                                                "const": "conda-recipe-v1"
                                            },
                                            {
                                                "type": "array",
                                                "contains": {
                                                    "const": "conda-recipe-v1"
                                                }
                                            }
                                        ]
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "recipe_dir",
                                    "extras"
                                ],
                                "properties": {
                                    "extras": {
                                        "allOf": [
                                            {
                                                "required": [
                                                    "output_type",
                                                    "requirements_type"
                                                ]
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "output_type": {
                                                            "const": "package"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "required": [
                                                        "package_name"
                                                    ]
                                                },
                                                "else": {
                                                    "not": {
                                                        "required": [
                                                            "package_name"
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "properties": {
                                                        "output_type": {
                                                            "const": "staging"
                                                        }
                                                    }
                                                },
                                                "then": {
                                                    "required": [
                                                        "staging_name"
                                                    ]
                                                },
                                                "else": {
                                                    "not": {
                                                        "required": [
                                                            "staging_name"
                                                        ]
                                                    }
                                                }
                                            },
                                            {
                                                "if": {
                                                    "required": [
                                                        "test_index"
                                                    ]
                                                },
                                                "then": {
                                                    "properties": {
                                                        "output_type": {
                                                            "enum": [
                                                                "requirements",
                                                                "package"
                                                            ]
                                                        },
                                                        "requirements_type": {
                                                            "enum": [
                                                                "build",
                                                                "run"
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "output": {
                                        "type": "array",
                                        "allOf": [
                                            {
                                                "contains": {
                                                    "const": "pyproject"
                                                }
                                            },
                                            {
                                                "contains": {
                                                    "const": "conda-recipe-v1"
                                                }
                                            }
                                        ]
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "extras": {
                                        "required": [
                                            "table"
                                        ]
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            "minProperties": 1
        },
        "dependencies": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties": {
                        "common": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "output_types": {"$ref": "#/$defs/outputs"},
                                    "filters": {"$ref": "#/$defs/filters"},
                                    "packages": {"$ref": "#/$defs/packages"}
                                },
                                "required": ["output_types", "packages"],
                                "additionalProperties": false,
                                "allOf": [
                                    {"$ref": "#/$defs/dependency-output-packages"},
                                    {"$ref": "#/$defs/dependency-output-filters"}
                                ]
                            }
                        },
                        "specific": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "output_types": {"$ref": "#/$defs/outputs"},
                                    "filters": {"$ref": "#/$defs/filters"},
                                    "matrices": {"$ref": "#/$defs/matrices"}
                                },
                                "required": ["output_types", "matrices"],
                                "additionalProperties": false,
                                "allOf": [
                                    {"$ref": "#/$defs/dependency-output-packages"},
                                    {"$ref": "#/$defs/dependency-output-filters"}
                                ]
                            }
                        }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
                }
            }
        },
        "channels": {"$ref": "#/$defs/channels"}
    },
    "required": ["files", "dependencies"],
    "additionalProperties": false,
    "$defs": {
        "channel": {
            "type": "string",
            "format": "iri-reference"
        },
        "channel-list": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/channel"
            }
        },
        "channels": {
            "$oneOf": [
                {"$ref": "#/$defs/channel"},
                {"$ref": "#/$defs/channel-list"}
            ]
        },
        "matrix": {
            "type": "object",
            "patternProperties": {
                ".*": {
                    "type": "array",
                    "items": {"oneOf": [
                        {"type": "string"},
                        {"type": "null"}
                    ]}
                }
            }
        },
        "matrix-matcher": {
            "type": "object",
            "properties": {
                "matrix": {
                    "oneOf": [
                        {
                            "type": "object",
                            "patternProperties": {
                                ".*": {"type": "string"}
                            }
                        },
                        {"type": "null"}
                    ]
                },
                "packages": {"oneOf": [
                    {"$ref": "#/$defs/packages"},
                    {"type": "null"}
                ]}
            },
            "requiredProperties": ["matrix", "packages"],
            "additionalProperties": false
        },
        "matrices": {
            "type": "array",
            "items": {"$ref": "#/$defs/matrix-matcher"}
        },
        "output-types": {
            "enum": ["conda", "requirements", "constraints", "pyproject", "conda-recipe-v1"]
        },
        "output-types-array": {
            "type": "array",
            "items": {"$ref": "#/$defs/output-types"}
        },
        "outputs": {
            "oneOf": [
                {"$ref": "#/$defs/output-types"},
                {"$ref": "#/$defs/output-types-array"},
                {"const": "none"}
            ]
        },
        "packages": {
            "type": "array",
            "items": {
                "oneOf": [
                    {"$ref": "#/$defs/requirement"},
                    {"$ref": "#/$defs/pip-requirements"},
                    {"$ref": "#/$defs/recipe-conditional"}
                ]
            }
        },
        "requirement": {
            "type": "string"
        },
        "requirements": {
            "type": "array",
            "items": {
                    "$ref": "#/$defs/requirement"
                },
            "minItems": 1

        },
        "pip-requirements": {
            "type": "object",
            "properties": {
                "pip": {"$ref": "#/$defs/requirements"}
            },
            "additionalProperties": false,
            "required": ["pip"]
        },
        "extras": {
            "type": "object",
            "properties": {
                "table": {
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "output_type": {
                    "enum": [
                        "requirements",
                        "package",
                        "staging"
                    ]
                },
                "package_name": {
                    "type": "string"
                },
                "staging_name": {
                    "type": "string"
                },
                "requirements_type": {
                    "type": "string",
                    "pattern": "^[^.]+(\\.[^.]+)*$"
                },
                "test_index": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "recipe-conditional": {
            "type": "object",
            "properties": {
                "if": {
                    "type": "string"
                },
                "then": {
                    "$ref": "#/$defs/recipe-branch"
                },
                "else": {
                    "$ref": "#/$defs/recipe-branch"
                }
            },
            "required": [
                "if",
                "then"
            ],
            "additionalProperties": false
        },
        "recipe-item": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "$ref": "#/$defs/recipe-conditional"
                }
            ]
        },
        "recipe-branch": {
            "oneOf": [
                {
                    "$ref": "#/$defs/recipe-item"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/recipe-item"
                    }
                }
            ]
        },
        "filters": {
            "type": "object",
            "properties": {
                "requirements_types": {
                    "oneOf": [
                        {"type": "string", "pattern": "^[^.]+(\\.[^.]+)*$"},
                        {
                            "type": "array",
                            "items": {"type": "string", "pattern": "^[^.]+(\\.[^.]+)*$"}
                        }
                    ]
                },
                "recipe_dir": {
                    "type": "string",
                    "minLength": 1,
                    "not": {"const": "!"}
                }
            },
            "additionalProperties": false
        },
        "dependency-output-filters": {
            "if": {"required": ["filters"]},
            "then": {
                "properties": {
                    "output_types": {"enum": ["conda-recipe-v1", ["conda-recipe-v1"]]}
                }
            }
        },
        "dependency-output-packages": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "output_types": {
                                "enum": [
                                    "conda-recipe-v1",
                                    [
                                        "conda-recipe-v1"
                                    ]
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "packages": {
                                "items": {
                                    "$ref": "#/$defs/recipe-item"
                                }
                            },
                            "matrices": {
                                "items": {
                                    "properties": {
                                        "packages": {
                                            "items": {
                                                "$ref": "#/$defs/recipe-item"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "output_types": {
                                "anyOf": [
                                    {
                                        "const": "conda-recipe-v1"
                                    },
                                    {
                                        "type": "array",
                                        "contains": {
                                            "const": "conda-recipe-v1"
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "packages": {
                                "items": {
                                    "not": {
                                        "$ref": "#/$defs/pip-requirements"
                                    }
                                }
                            },
                            "matrices": {
                                "items": {
                                    "properties": {
                                        "packages": {
                                            "items": {
                                                "not": {
                                                    "$ref": "#/$defs/pip-requirements"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "not": {
                            "properties": {
                                "output_types": {
                                    "enum": [
                                        "conda-recipe-v1",
                                        [
                                            "conda-recipe-v1"
                                        ]
                                    ]
                                }
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "packages": {
                                "items": {
                                    "not": {
                                        "$ref": "#/$defs/recipe-conditional"
                                    }
                                }
                            },
                            "matrices": {
                                "items": {
                                    "properties": {
                                        "packages": {
                                            "items": {
                                                "not": {
                                                    "$ref": "#/$defs/recipe-conditional"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
